#! /bin/sh

#PBS -j oe
#PBS -o /lfs/h2/emc/lam/noscrub/Jun.Du/reps.v1.0.0/launch/logs/reps_enspost_preproc.out__DOM__CYC_
#PBS -e /lfs/h2/emc/lam/noscrub/Jun.Du/reps.v1.0.0/launch/logs/reps_enspost_preproc.err__DOM__CYC_
##PBS -l select=_NODES_:ncpus=_PTILE_:mem=17GB
 #PBS -l select=_NODES_:ncpus=_PTILE_:mem=500GB -l place=excl
#PBS -q dev
#PBS -A SREF-DEV
##PBS -l walltime=000:30:00
#PBS -l walltime=001:30:00

export USER=Jun.Du
export HOMEreps=/lfs/h2/emc/lam/noscrub/${USER}/reps.v1.0.0
source ${HOMEreps}/versions/run_enspost.ver

export OMP_NUM_THREADS=1

module purge
module load envvar/1.0
module load PrgEnv-intel/8.1.0
module load craype/2.7.13
module load intel/19.1.3.304
module load cray-mpich/8.1.12
module load cray-pals/1.0.12

module load prod_util/${prod_util_ver}
module load wgrib2/${wgrib2_ver}
module load netcdf/${netcdf_ver}
module load g2/${g2_ver}
module load g2tmpl/${g2tmpl_ver}
module load jasper/${jasper_ver}
module load libpng/${libpng_ver}
module load zlib/${zlib_ver}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}

export numprocs=_NTASK_
export spanprocs=_PTILE_
export NTASK=_NTASK_
export PTILE=_PTILE_

export RUN_ENVIR=para
export envir=para
#export RUN_ENVIR=test
#export envir=test
export NET=reps
export RUN=sref

export NEST=_DOM_
export cyc=_CYC_
export DATE=_DATE_

export PDY=${DATE}
export PDYm1=`$NDATE -24 ${PDY}${cyc} | cut -c1-8`

echo PDY is $PDY
export PDYm1 is $PDYm1

export DATAROOT=/lfs/h2/emc/stmp/${USER}/tmp
export COMROOT=/lfs/h2/emc/ptmp/${USER}/${envir}/com
export COMPATH=/lfs/h2/emc/ptmp/${USER}

export DATA=${DATAROOT}/reps_enspost_preproc_${NEST}_${cyc}_${envir}
export DATA2=${DATAROOT}/reps_enspost_thin_${NEST}_${cyc}_${envir}

echo DATA is $DATA
echo DATA2 is $DATA2

export COMINgefs="/lfs/h1/ops/prod/com/gefs/${gefs_ver}"

#export GESROOT=`compath.py -o ${NET}/${gefs_ver}/nwges`
#export GESOUT=`compath.py -o ${NET}/${gefs_ver}/nwges`
#if [ ! -e $GESROOT ] ; then
# mkdir -p $GESROOT
#fi

#export KEEPDATA=NO
export KEEPDATA=YES

export SENDCOM=YES
export SENDECF=NO
export SENDDBN=NO
export job=reps_enspost_preproc_${NEST}_${cyc}

$HOMEreps/jobs/JREPS_ENSPOST_PREPROC
